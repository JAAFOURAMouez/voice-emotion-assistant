# Copier ce fichier en .env puis ajuster. Toutes les valeurs ci-dessous sont les valeurs par défaut.

# --- LLM local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Le premier appel charge le modèle en mémoire : il peut dépasser une minute sur CPU.
OLLAMA_TIMEOUT_S=120
OLLAMA_TEMPERATURE=0.7
# Nombre d'échanges précédents renvoyés au modèle.
LLM_HISTORY_TURNS=10
# Refuse par défaut tout serveur Ollama qui n'est pas sur cette machine.
ALLOW_REMOTE_OLLAMA=false

# --- Langue de l'interface et des réponses ---
LANGUAGE=fr

# --- Audio ---
SAMPLE_RATE=16000
# L'audio brut n'est pas conservé par défaut (vie privée).
STORE_RAW_AUDIO=false
AUDIO_DIR=data/audio
# Micro à utiliser (nom ou numéro, voir : python -m sounddevice). Vide = micro par défaut.
AUDIO_INPUT_DEVICE=

# --- Détection de parole (découpage en tours) ---
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
# Durée de silence qui termine un tour de parole.
VAD_MIN_SILENCE_MS=800
VAD_SPEECH_PAD_MS=300
MAX_TURN_S=30
# Abandon de l'écoute si personne ne parle pendant ce délai.
LISTEN_TIMEOUT_S=15

# --- Transcription (faster-whisper) ---
# Sur une machine modeste : WHISPER_MODEL=base
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Vide = même langue que LANGUAGE ; "auto" = détection automatique.
WHISPER_LANGUAGE=
# 1 = plus rapide sur CPU ; 5 = un peu plus précis.
WHISPER_BEAM_SIZE=1

# --- Émotion estimée ---
EMOTION_MODEL=superb/wav2vec2-base-superb-er
EMOTION_DEVICE=cpu
# Part du modèle wav2vec2 dans le score final (le reste vient de la prosodie).
# Le modèle est entraîné sur de l'anglais : ne pas trop le favoriser en français.
EMOTION_MODEL_WEIGHT=0.35
EMOTION_CONFIDENCE_THRESHOLD=0.5
# Poids des mots d'émotion dits explicitement (« très énervé ») ; 0 = voix seule
EMOTION_TEXT_GAIN=5.0
# Nombre de tours avant que la ligne de base vocale soit jugée fiable.
BASELINE_MIN_TURNS=5
# Nombre de tours précédents pris en compte pour la ligne de base vocale.
BASELINE_WINDOW=20

# --- Exercices de respiration / relaxation ---
EXERCISE_CONSECUTIVE_TURNS=2
EXERCISE_COOLDOWN_MINUTES=15

# --- Synthèse vocale (Piper) ---
PIPER_VOICE=fr_FR-siwis-medium
PIPER_VOICES_DIR=data/voices
TTS_ENABLED=true
# Vitesse de la voix (1 = normale, 1.2 = plus rapide)
TTS_SPEED=1.0
# Haut-parleur (nom ou numéro sounddevice) ; vide = périphérique par défaut
AUDIO_OUTPUT_DEVICE=

# --- Stockage local ---
# --- Interface web ---
# 127.0.0.1 = accessible depuis cette machine seulement
API_HOST=127.0.0.1
API_PORT=8000
# Origines supplémentaires autorisées (derrière un reverse proxy), séparées par des virgules
ALLOWED_ORIGINS=
WEB_DIST=web/dist

DB_PATH=data/voxemo.db
